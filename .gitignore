# ==============================================================================
# Coach Porygon VGC — Repository .gitignore
# ==============================================================================

# 1. Python Bytecode, Caches & Virtual Environments
__pycache__/
*.py[codz]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/
ENV/

# 2. Raw Office / Google Drive Binary Exports (Convert to .md / .csv instead)
*.docx
*.doc
*.xlsx
*.xls
~$*

# 3. Temporary Simulation Payloads, Scratch Scripts & Logs
scratch/
tmp/
temp/
*.log
*.tmp
*.bak
tempCodeRunnerFile.py

# 4. Secrets, Credentials & Environment Variables
.env
.env.*
!.env.example
credentials.json
token.json
client_secret*.json
*.pem
*.key

# 5. OS & Editor Metadata
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.swo

# 6. Private Coaching Telemetry, Rosters, Scouting Intel & Prototype Dossiers
#    (Public schema templates live alongside as *.example.csv)
data/Raw_Matches.csv
data/Teams.csv
data/Playstyle_Diagnostics.csv
data/Scouted_Raw_Matches.csv
data/Scouted_Teams.csv
data/Recent_Matches.csv
data/trainer_profile.json
data/compendium/Proto*.md

# 7. Explicitly Tracked Agent Customizations, Public Data & Schema Examples
!.agents/
!.agents/**
!AGENTS.md
!data/*.example.csv
!data/*.example.json
!data/pokedex_cache.json
!data/compendium/Champions_Mechanics_Compendium.md
!data/compendium/M-C Calcs & Sets.md
!data/compendium/README.md
