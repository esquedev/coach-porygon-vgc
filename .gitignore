# ==============================================================================
# Coach Porygon VGC — Repository .gitignore
# ==============================================================================

# 1. Python Bytecode, Caches & Virtual Environments
__pycache__/
*.py[codz]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage*
htmlcov/
.venv/
venv/
env/
ENV/

# 2. Raw Office / Google Drive Binary Exports (Convert to .jsonl / .csv instead)
*.docx
*.doc
*.xlsx
*.xls
~$*

# 3. Temporary Simulation Payloads, Scratch Scripts & Logs
scratch/*
!scratch/.gitkeep
tmp/
temp/
.temp/
scripts/temp_*.py
scripts/patch_*.py
*.log
*.tmp
*.bak
tempCodeRunnerFile.py
reports/*
!reports/.gitkeep
!reports/agent_audits/
logs/
*.roofline.txt

# 4. Secrets, Credentials & Environment Variables
.env
.env.*
!.env.example
credentials.json
token.json
client_secret*.json
*.pem
*.key

# 5. OS & Editor Metadata
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.swo

# 6. Private Coaching Telemetry, Rosters, Scouting Intel & Heavy Tournament Dumps
data/
src/data/
reports/*.pdf
reports/*.html
!reports/agent_audits/

# 7. Explicitly Tracked Agent Customizations, Public Data & Schema Examples
!.agents/
!.agents/**
!AGENTS.md
!data/*.example.csv
!data/*.example.json
!data/*.example.jsonl
!data/pokedex_cache.json
!data/compendium/Champions_Mechanics_Compendium.md
!data/compendium/M-C Calcs & Sets.md
!data/compendium/README.md

!tests/data/
!tests/data/**
